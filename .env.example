# Environment template. Copy to .env for local work, or set these in Vercel.
# Never commit real values.

# Public URL of the app. Local: http://localhost:3000. Vercel: https://<project>.vercel.app
NEXTAUTH_URL=
# Auth.js session secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# Bearer secret for /api/cron/*. Vercel Cron sends it automatically; your external
# pinger for /api/cron/poll must send "Authorization: Bearer <CRON_SECRET>". openssl rand -hex 32
CRON_SECRET=
# 32-byte hex key that encrypts the stored Composio credential: openssl rand -hex 32
# Never change it after connecting without re-running scripts/connect-composio.ts.
ENCRYPTION_KEY=

# PostgreSQL. Pooled URL for the app. On Neon, DIRECT_DATABASE_URL is the unpooled
# URL used by prisma migrate; leave it empty elsewhere and DATABASE_URL is used.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Redis over TCP (redis:// or rediss://). Must support blocking commands and have
# eviction turned off, or BullMQ loses jobs. Upstash TCP URLs work.
REDIS_URL=

# Magic-link sign-in email via Resend: API key and a sender on a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=OpenReply <login@your-domain.example>
# Optional: send sign-in email through your own SMTP server instead of Resend.
EMAIL_SERVER=
# Comma-separated emails allowed to sign in. Empty denies everyone.
ALLOWED_EMAILS=
# Contact address shown on /privacy, /terms and /data-deletion.
CONTACT_EMAIL=

# Heartbeat TTL for /api/health. On Vercel use 420 so it outlives the 5 minute poll gap.
# Unset uses the default, which suits the always-on Docker worker.
WORKER_HEARTBEAT_TTL_SECONDS=

# Only for scripts/connect-composio.ts (run locally, never set in Vercel):
# EXPECTED_IG_USERNAME=     # printed by --dry
# EXPECTED_IG_USER_ID=      # printed by --dry
# OWNER_EMAIL=              # the email you signed in with

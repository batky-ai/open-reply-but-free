# Docker stack environment. Copy to deploy/.env and fill in. Never commit deploy/.env.
# DATABASE_URL and REDIS_URL are set by deploy/compose.yml; do not add them here.

# Postgres password for the bundled database. openssl rand -hex 24
POSTGRES_PASSWORD=

# Public HTTPS URL of your reverse proxy, e.g. https://replies.example.com
NEXTAUTH_URL=
# openssl rand -base64 32
NEXTAUTH_SECRET=
# openssl rand -hex 32. Bearer secret for /api/cron/*.
CRON_SECRET=
# openssl rand -hex 32. Encrypts the stored Composio credential. Never change it after connecting.
ENCRYPTION_KEY=

# Magic-link sign-in email. Either Resend (API key plus a sender on a verified domain)...
RESEND_API_KEY=
EMAIL_FROM=OpenReply <login@your-domain.example>
# ...or your own SMTP server instead of Resend, e.g. smtps://user%40example.com:password@mail.example.com:465
EMAIL_SERVER=

# Comma-separated emails allowed to sign in. Empty denies everyone.
ALLOWED_EMAILS=
# Shown on /privacy, /terms and /data-deletion.
CONTACT_EMAIL=

# Host port for the web app (bound to 127.0.0.1). Default 3000.
WEB_PORT=3000
